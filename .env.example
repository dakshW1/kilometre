# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google AI Studio → aistudio.google.com/apikey (server only, never NEXT_PUBLIC)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# true = AI routes return cached demo responses (use on stage if Wi-Fi is bad)
DEMO_MODE=false
